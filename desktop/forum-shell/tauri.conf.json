{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Vision Forum",
  "version": "0.1.0-dev.1",
  "identifier": "org.aivisionforum.agent",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Vision Forum",
        "url": "index.html",
        "width": 1180,
        "height": 640,
        "minWidth": 1020,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "dataflow/translation_qwen35.yml": "dataflow/translation_qwen35.yml",
      "../scripts/macos_preflight.sh": "scripts/macos_preflight.sh",
      "../scripts/macos_bootstrap.sh": "scripts/macos_bootstrap.sh",
      "../scripts/dora_binary.sh": "scripts/dora_binary.sh",
      "../resources/setup/prepare_forum_models.py": "setup/prepare_forum_models.py"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "bundleVersion": "0.1.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {}
}
